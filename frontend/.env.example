# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o git.
# Tudo que começa com VITE_ vai para o navegador: use só a chave PUBLICÁVEL do Supabase,
# nunca a secret / service_role.

# A S01 só lê a tabela room_telemetry do Supabase. Sem URL/chave, aguarda a conexão.
VITE_TELEMETRIA_MODO=supabase

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
